# The server stays local by default. Do not bind it publicly without real authentication.
PORT=8787
HOST=127.0.0.1
FREEBUFF_MCP_ALLOW_NETWORK=false

# The folder that Freebuff can inspect or edit. If blank, it defaults to this repo root.
FREEBUFF_WORKSPACE_ROOT=
FREEBUFF_WORKSPACE_NAME=

# Choose one runner credential. Never commit real values.
CODEBUFF_API_KEY=

# Or use an OpenAI-compatible provider through the Freebuff SDK.
FREEBUFF_BYOK_API_KEY=
FREEBUFF_BYOK_MODEL=gpt-5.6
FREEBUFF_BYOK_BASE_URL=https://api.openai.com/v1
